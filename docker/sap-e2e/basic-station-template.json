{
  "$schemaVersion": 1,
  "idTagsFile": "idtags.json",
  "baseName": "sap-basic",
  "fixedName": true,
  "chargePointModel": "ChargeHA Basic",
  "chargePointVendor": "ChargeHA",
  "power": 7400,
  "powerUnit": "W",
  "powerSharedByConnectors": false,
  "currentOutType": "AC",
  "numberOfPhases": 1,
  "voltageOut": 240,
  "numberOfConnectors": 1,
  "randomConnectors": false,
  "coherentMeterValues": true,
  "evProfilesFile": "ev-profiles-e2e.json",
  "Configuration": {
    "configurationKey": [
      {
        "key": "MeterValuesSampledData",
        "readonly": false,
        "value": "Energy.Active.Import.Register"
      },
      {
        "key": "MeterValueSampleInterval",
        "readonly": false,
        "value": "60"
      },
      {
        "key": "SupportedFeatureProfiles",
        "readonly": true,
        "value": "Core,SmartCharging,RemoteTrigger"
      },
      {
        "key": "LocalAuthListEnabled",
        "readonly": false,
        "value": "false"
      },
      {
        "key": "AuthorizeRemoteTxRequests",
        "readonly": false,
        "value": "false"
      },
      {
        "key": "WebSocketPingInterval",
        "readonly": false,
        "value": "60"
      },
      {
        "key": "ReserveConnectorZeroSupported",
        "readonly": false,
        "value": "false"
      }
    ]
  },
  "AutomaticTransactionGenerator": {
    "enable": false,
    "minDuration": 600,
    "maxDuration": 3600,
    "minDelayBetweenTwoTransactions": 15,
    "maxDelayBetweenTwoTransactions": 30,
    "probabilityOfStart": 1,
    "stopAfterHours": 8,
    "requireAuthorize": true
  },
  "Connectors": {
    "0": {},
    "1": {
      "bootStatus": "Available",
      "maximumPower": 7400,
      "MeterValues": [
        {
          "unit": "A",
          "context": "Sample.Periodic",
          "measurand": "Current.Import",
          "location": "Outlet"
        },
        {
          "unit": "V",
          "context": "Sample.Periodic",
          "measurand": "Voltage",
          "location": "Outlet"
        },
        {
          "unit": "W",
          "context": "Sample.Periodic",
          "measurand": "Power.Active.Import",
          "location": "Outlet"
        },
        {
          "unit": "Wh",
          "context": "Sample.Periodic",
          "measurand": "Energy.Active.Import.Register",
          "location": "Outlet"
        },
        {
          "unit": "Percent",
          "context": "Sample.Periodic",
          "measurand": "SoC",
          "location": "EV"
        }
      ]
    }
  }
}
